# Anthropic API key (server-only). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model for the estimator. Haiku is the cheapest; switch to a Sonnet model for richer plans.
ANTHROPIC_MODEL=claude-haiku-5-5

# Cloudflare Turnstile. The values below are Cloudflare's official TEST keys
# (always pass) so the demo works locally. Replace both with your real keys before going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: require Turnstile siteverify to report this hostname (e.g. your production domain).
# TURNSTILE_HOSTNAME=

# Abuse limits
RATE_LIMIT_PER_HOUR=5
DAILY_LIMIT=150
